NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Canonical public origin of this deployment (no trailing slash). Used to
# build the password-reset email link — must NOT be derived from request
# headers, since those are attacker-controllable.
APP_ORIGIN=https://your-deployed-domain.com
