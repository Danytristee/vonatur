# Valid values: all | none | root. "root" (the previous value) should allow
# a remote dependency declared directly in this project's own package.json —
# that's exactly what xlsx (installed from SheetJS's CDN, not the npm
# registry) is — but it still got blocked on Vercel's fresh install. Using
# "all" since xlsx is the only remote dependency here and it's intentional.
allow-remote=all

# agents-inc (dev tooling, unrelated to the app) pulls in a Svelte/Vite peer
# tree that conflicts with unrelated packages here — harmless to relax.
legacy-peer-deps=true
